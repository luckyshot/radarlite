<?xml version="1.0" encoding="utf-8"?>
<!-- The top is a drive dashboard; detailed controls are deliberately below it. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center_vertical">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="12dp" android:contentDescription="@string/app_name" android:src="@mipmap/ic_launcher_round" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="24sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROAD ALERTS" android:textColor="@color/text_secondary" android:textSize="11sp" android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- One large, familiar target makes starting a drive quick without navigating settings. -->
        <LinearLayout style="@style/DriveCard">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MONITORING" android:textColor="@color/drive_label" android:textSize="12sp" android:letterSpacing="0.12" android:fontFamily="sans-serif-medium" />
                    <TextView android:id="@+id/tvServiceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/badge_status_stopped" android:fontFamily="sans-serif-medium" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="@string/status_stopped" android:textColor="@color/text_primary" android:textSize="15sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchService" android:layout_width="72dp" android:layout_height="56dp" android:contentDescription="Turn monitoring on or off" android:showText="false" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Start before you set off. Alerts run in the background while you navigate." android:textColor="@color/drive_copy" android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="18dp" android:background="@color/drive_divider" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout style="@style/DriveMetric" android:layout_marginEnd="8dp"><TextView style="@style/DriveMetricLabel" android:text="SPEED" /><TextView android:id="@+id/tvSpeed" style="@style/DriveMetricValue" android:text="—" /></LinearLayout>
                <LinearLayout style="@style/DriveMetric"><TextView style="@style/DriveMetricLabel" android:text="NEXT ALERT" /><TextView android:id="@+id/tvClosestCamera" style="@style/DriveMetricValue" android:text="—" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- A glanceable summary avoids making the driver scan a list of small rows. -->
        <LinearLayout style="@style/GlanceCard">
            <LinearLayout style="@style/GlanceItem"><TextView style="@style/GlanceLabel" android:text="AHEAD" /><TextView android:id="@+id/tvCamerasNear" style="@style/GlanceValue" android:text="0" /><TextView style="@style/GlanceHint" android:text="alerts nearby" /></LinearLayout>
            <View style="@style/GlanceDivider" />
            <LinearLayout style="@style/GlanceItem"><TextView style="@style/GlanceLabel" android:text="HEADING" /><TextView android:id="@+id/tvHeading" style="@style/GlanceValue" android:text="—" /><TextView style="@style/GlanceHint" android:text="your direction" /></LinearLayout>
        </LinearLayout>

        <TextView style="@style/ParkedLabel" android:text="SET UP WHEN PARKED" />
        <!-- Speech choices do not affect monitoring and are separated from safety alerts. -->
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="SPEED ANNOUNCEMENTS" /><TextView style="@style/SectionHint" android:text="Choose speeds to hear as you accelerate." /><LinearLayout android:id="@+id/speedAnnouncementOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" /></LinearLayout>

        <LinearLayout style="@style/ScreenCard">
            <TextView style="@style/SectionLabel" android:text="ALERTS TO HEAR" /><TextView style="@style/SectionHint" android:text="Leave on only the warnings useful for your route." />
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Speed cameras" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchSpeedCamera" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Red lights" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchRedLight" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Average speed zones" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAverageSpeed" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Sharp curves" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchSharpCurve" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Dangerous junctions" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchDangerousJunction" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Level crossings" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchLevelCrossing" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Traffic calming" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTrafficCalming" style="@style/SettingSwitch" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Over a camera limit" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switchOverspeed" style="@style/SettingSwitch" /></LinearLayout>
        </LinearLayout>

        <!-- Supporting information remains available, but is below drive controls. -->
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="LOCATION" />
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="GPS" /><TextView android:id="@+id/tvGpsMode" style="@style/RowValue" android:text="—" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Accuracy" /><TextView android:id="@+id/tvAccuracy" style="@style/RowValue" android:text="—" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Last fix" /><TextView android:id="@+id/tvLastFix" style="@style/RowValue" android:text="—" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Fix time" /><TextView android:id="@+id/tvFixTime" style="@style/RowValue" android:text="—" /></LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="ALERT DATABASE" /><TextView style="@style/SectionHint" android:text="Up to two countries can be active at once." />
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Country 1" /><Spinner android:id="@+id/spinnerCountry1" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Country 2" /><Spinner android:id="@+id/spinnerCountry2" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Version" /><TextView android:id="@+id/tvDbVersion" style="@style/RowValue" android:text="—" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Points" /><TextView android:id="@+id/tvDbCount" style="@style/RowValue" android:text="—" /></LinearLayout>
            <LinearLayout style="@style/StatusRow"><TextView style="@style/RowLabel" android:text="Last check" /><TextView android:id="@+id/tvLastCheck" style="@style/RowValue" android:text="—" /></LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCheckUpdate" style="@style/PrimaryButton" android:layout_marginTop="12dp" android:text="@string/btn_check_update" />
        </LinearLayout>
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="RECENT ALERTS" /><androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAlerts" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" /><TextView android:id="@+id/tvNoAlerts" style="@style/EmptyState" android:text="@string/no_alerts" /></LinearLayout>
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="@string/sound_test_title" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btnTestCamera" style="@style/SoundTestButton" android:layout_marginEnd="6dp" android:text="@string/btn_test_camera" /><com.google.android.material.button.MaterialButton android:id="@+id/btnTestOverspeed" style="@style/SoundTestButton" android:layout_marginStart="6dp" android:text="@string/btn_test_overspeed" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btnTestCurve" style="@style/SoundTestButton" android:layout_marginEnd="6dp" android:text="@string/btn_test_curve" /><com.google.android.material.button.MaterialButton android:id="@+id/btnTestJunction" style="@style/SoundTestButton" android:layout_marginStart="6dp" android:text="@string/btn_test_junction" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/btnTestCrossing" style="@style/SoundTestButton" android:layout_marginEnd="6dp" android:text="@string/btn_test_crossing" /><com.google.android.material.button.MaterialButton android:id="@+id/btnTestUrgent" style="@style/SoundTestButton" android:layout_marginStart="6dp" android:text="@string/btn_test_urgent" /></LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/ScreenCard"><TextView style="@style/SectionLabel" android:text="@string/guide_title" /><TextView style="@style/GuideText" android:text="@string/guide_passive" /><TextView style="@style/GuideText" android:text="@string/guide_sound" /><TextView style="@style/SectionLabel" android:layout_marginTop="10dp" android:text="@string/about_title" /><TextView android:id="@+id/tvPrivacy" style="@style/LinkText" android:text="@string/about_privacy" /><TextView android:id="@+id/tvSource" style="@style/LinkText" android:text="@string/about_source" /><TextView android:id="@+id/tvOsm" style="@style/LinkText" android:text="@string/about_data" /></LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
